server {
    server_name muraji-api.wathbahs.com;

    location / {
        proxy_pass http://localhost:2020;
        proxy_http_version 1.1;
        
        # Forward original host and IP
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # WebSocket support (if needed)
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
       client_max_body_size 100M; 

    # INCREASE THESE from 60s to 300s
    proxy_connect_timeout 6000s;
    proxy_send_timeout 6000s;
    proxy_read_timeout 6000s;
    }

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/muraji-api.wathbahs.com/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/muraji-api.wathbahs.com/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}
server {
    if ($host = muraji-api.wathbahs.com) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    server_name muraji-api.wathbahs.com;
    return 404; # managed by Certbot


}
