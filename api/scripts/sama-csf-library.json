{
  "urn": "urn:intuitem:risk:library:sama-csf",
  "ref_id": "SAMA-CSF",
  "provider": "SAMA",
  "name": "SAMA Cyber Security Framework",
  "description": "The Saudi Arabian Monetary Authority (SAMA) Cyber Security Framework provides a comprehensive set of cyber security principles and objectives to help member organizations develop their cyber security capabilities. The framework is mandatory for all financial institutions regulated by SAMA.\n\nhttps://www.sama.gov.sa/en-US/RulesInstructions/CyberSecurity/Pages/default.aspx",
  "copyright": "Saudi Arabian Monetary Authority (SAMA)",
  "version": 1,
  "locale": "en",
  "publication_date": "2017-05-01",
  "packager": "intuitem",
  "content": {
    "framework": {
      "urn": "urn:intuitem:risk:framework:sama-csf",
      "ref_id": "SAMA-CSF",
      "name": "SAMA Cyber Security Framework",
      "description": "The Saudi Arabian Monetary Authority (SAMA) Cyber Security Framework provides cyber security principles and objectives for financial institutions.",
      "requirement_nodes": [
        {"urn": "urn:intuitem:risk:req_node:sama-csf:1", "assessable": false, "depth": 1, "ref_id": "1", "name": "Cyber Security Leadership and Governance"},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:1.1", "assessable": false, "depth": 2, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:1", "ref_id": "1.1", "name": "Cyber Security Strategy"},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:1.1.1", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:1.1", "ref_id": "1.1.1", "description": "The Member Organization shall define and document a cyber security strategy that is aligned with the organization's business strategy and objectives."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:1.1.2", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:1.1", "ref_id": "1.1.2", "description": "The cyber security strategy shall be reviewed and updated at least annually or when there are significant changes to the business or threat environment."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:1.1.3", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:1.1", "ref_id": "1.1.3", "description": "The cyber security strategy shall be approved by the Board of Directors or equivalent governing body."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:1.2", "assessable": false, "depth": 2, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:1", "ref_id": "1.2", "name": "Cyber Security Governance"},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:1.2.1", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:1.2", "ref_id": "1.2.1", "description": "The Member Organization shall establish a cyber security governance structure with clearly defined roles, responsibilities, and accountability."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:1.2.2", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:1.2", "ref_id": "1.2.2", "description": "A dedicated cyber security function shall be established, led by a Chief Information Security Officer (CISO) or equivalent role."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:1.2.3", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:1.2", "ref_id": "1.2.3", "description": "The CISO or equivalent shall report directly to senior management and have regular access to the Board or relevant committees."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:1.2.4", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:1.2", "ref_id": "1.2.4", "description": "Cyber security governance shall be integrated with the organization's overall corporate governance framework."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:1.3", "assessable": false, "depth": 2, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:1", "ref_id": "1.3", "name": "Cyber Security Policies and Procedures"},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:1.3.1", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:1.3", "ref_id": "1.3.1", "description": "The Member Organization shall develop and maintain comprehensive cyber security policies covering all domains of the framework."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:1.3.2", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:1.3", "ref_id": "1.3.2", "description": "Cyber security policies shall be approved by senior management and communicated to all relevant stakeholders."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:1.3.3", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:1.3", "ref_id": "1.3.3", "description": "Detailed procedures shall be developed to support the implementation of cyber security policies."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:1.3.4", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:1.3", "ref_id": "1.3.4", "description": "Policies and procedures shall be reviewed and updated at least annually or when significant changes occur."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:1.4", "assessable": false, "depth": 2, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:1", "ref_id": "1.4", "name": "Cyber Security Roles and Responsibilities"},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:1.4.1", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:1.4", "ref_id": "1.4.1", "description": "Cyber security roles and responsibilities shall be clearly defined for all employees, contractors, and third parties."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:1.4.2", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:1.4", "ref_id": "1.4.2", "description": "Segregation of duties shall be implemented to prevent conflicts of interest and reduce the risk of fraud."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:1.4.3", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:1.4", "ref_id": "1.4.3", "description": "Job descriptions shall include cyber security responsibilities appropriate to each role."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:2", "assessable": false, "depth": 1, "ref_id": "2", "name": "Cyber Security Risk Management and Compliance"},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:2.1", "assessable": false, "depth": 2, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:2", "ref_id": "2.1", "name": "Cyber Security Risk Management"},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:2.1.1", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:2.1", "ref_id": "2.1.1", "description": "The Member Organization shall establish a cyber security risk management framework integrated with enterprise risk management."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:2.1.2", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:2.1", "ref_id": "2.1.2", "description": "Cyber security risk assessments shall be conducted at least annually and when significant changes occur."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:2.1.3", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:2.1", "ref_id": "2.1.3", "description": "A cyber security risk register shall be maintained and regularly updated."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:2.1.4", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:2.1", "ref_id": "2.1.4", "description": "Risk treatment plans shall be developed and implemented for identified cyber security risks."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:2.1.5", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:2.1", "ref_id": "2.1.5", "description": "Risk acceptance decisions shall be documented and approved by appropriate management levels."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:2.2", "assessable": false, "depth": 2, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:2", "ref_id": "2.2", "name": "Regulatory Compliance"},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:2.2.1", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:2.2", "ref_id": "2.2.1", "description": "The Member Organization shall identify and comply with all applicable cyber security laws, regulations, and contractual requirements."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:2.2.2", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:2.2", "ref_id": "2.2.2", "description": "A compliance monitoring program shall be established to ensure ongoing adherence to regulatory requirements."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:2.2.3", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:2.2", "ref_id": "2.2.3", "description": "Compliance gaps shall be identified, documented, and remediated in a timely manner."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:2.3", "assessable": false, "depth": 2, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:2", "ref_id": "2.3", "name": "Cyber Security Audit"},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:2.3.1", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:2.3", "ref_id": "2.3.1", "description": "Internal cyber security audits shall be conducted at least annually by qualified personnel."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:2.3.2", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:2.3", "ref_id": "2.3.2", "description": "External cyber security audits shall be conducted by independent third parties at least every two years."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:2.3.3", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:2.3", "ref_id": "2.3.3", "description": "Audit findings shall be tracked and remediated according to their severity."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:3", "assessable": false, "depth": 1, "ref_id": "3", "name": "Cyber Security Operations and Technology"},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:3.1", "assessable": false, "depth": 2, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:3", "ref_id": "3.1", "name": "Human Resources Security"},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:3.1.1", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:3.1", "ref_id": "3.1.1", "description": "Background verification checks shall be conducted for all employees with access to sensitive information or systems."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:3.1.2", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:3.1", "ref_id": "3.1.2", "description": "Employment contracts shall include cyber security responsibilities and confidentiality agreements."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:3.1.3", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:3.1", "ref_id": "3.1.3", "description": "Employee termination procedures shall include revocation of access rights and return of assets."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:3.2", "assessable": false, "depth": 2, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:3", "ref_id": "3.2", "name": "Cyber Security Awareness and Training"},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:3.2.1", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:3.2", "ref_id": "3.2.1", "description": "A cyber security awareness program shall be established for all employees and contractors."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:3.2.2", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:3.2", "ref_id": "3.2.2", "description": "Cyber security awareness training shall be provided upon hiring and refreshed at least annually."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:3.2.3", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:3.2", "ref_id": "3.2.3", "description": "Role-specific cyber security training shall be provided to employees with elevated privileges or access to sensitive systems."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:3.2.4", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:3.2", "ref_id": "3.2.4", "description": "The effectiveness of awareness and training programs shall be measured and improved continuously."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:3.3", "assessable": false, "depth": 2, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:3", "ref_id": "3.3", "name": "Asset Management"},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:3.3.1", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:3.3", "ref_id": "3.3.1", "description": "An inventory of all information assets shall be maintained and regularly updated."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:3.3.2", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:3.3", "ref_id": "3.3.2", "description": "Asset owners shall be assigned for all critical information assets."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:3.3.3", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:3.3", "ref_id": "3.3.3", "description": "Information assets shall be classified based on their criticality and sensitivity."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:3.3.4", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:3.3", "ref_id": "3.3.4", "description": "Acceptable use policies shall be defined for information assets."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:3.4", "assessable": false, "depth": 2, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:3", "ref_id": "3.4", "name": "Identity and Access Management"},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:3.4.1", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:3.4", "ref_id": "3.4.1", "description": "A formal access control policy shall be defined based on the principle of least privilege."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:3.4.2", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:3.4", "ref_id": "3.4.2", "description": "User access management processes shall cover the entire access lifecycle from provisioning to de-provisioning."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:3.4.3", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:3.4", "ref_id": "3.4.3", "description": "Privileged access shall be strictly controlled, monitored, and reviewed regularly."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:3.4.4", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:3.4", "ref_id": "3.4.4", "description": "Multi-factor authentication shall be implemented for remote access and access to critical systems."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:3.4.5", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:3.4", "ref_id": "3.4.5", "description": "User access rights shall be reviewed at least quarterly for critical systems and semi-annually for other systems."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:3.4.6", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:3.4", "ref_id": "3.4.6", "description": "Strong password policies shall be enforced across all systems."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:3.5", "assessable": false, "depth": 2, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:3", "ref_id": "3.5", "name": "Network Security"},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:3.5.1", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:3.5", "ref_id": "3.5.1", "description": "Network architecture shall be designed with security in mind, implementing defense in depth principles."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:3.5.2", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:3.5", "ref_id": "3.5.2", "description": "Network segmentation shall be implemented to separate critical systems and sensitive data."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:3.5.3", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:3.5", "ref_id": "3.5.3", "description": "Firewalls shall be deployed at network perimeters and between network segments."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:3.5.4", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:3.5", "ref_id": "3.5.4", "description": "Intrusion detection and prevention systems shall be deployed to monitor network traffic."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:3.5.5", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:3.5", "ref_id": "3.5.5", "description": "Wireless networks shall be secured and segregated from the production network."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:3.5.6", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:3.5", "ref_id": "3.5.6", "description": "Remote access shall be secured using encrypted connections and multi-factor authentication."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:3.6", "assessable": false, "depth": 2, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:3", "ref_id": "3.6", "name": "System Security"},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:3.6.1", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:3.6", "ref_id": "3.6.1", "description": "Security hardening standards shall be defined and applied to all systems."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:3.6.2", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:3.6", "ref_id": "3.6.2", "description": "Operating systems and applications shall be kept updated with security patches."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:3.6.3", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:3.6", "ref_id": "3.6.3", "description": "Anti-malware solutions shall be deployed on all endpoints and servers."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:3.6.4", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:3.6", "ref_id": "3.6.4", "description": "Change management procedures shall be followed for all system changes."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:3.6.5", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:3.6", "ref_id": "3.6.5", "description": "System clocks shall be synchronized with trusted time sources."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:3.7", "assessable": false, "depth": 2, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:3", "ref_id": "3.7", "name": "Application Security"},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:3.7.1", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:3.7", "ref_id": "3.7.1", "description": "Secure software development lifecycle (SDLC) practices shall be implemented."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:3.7.2", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:3.7", "ref_id": "3.7.2", "description": "Security requirements shall be defined during the requirements phase of application development."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:3.7.3", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:3.7", "ref_id": "3.7.3", "description": "Code reviews and security testing shall be conducted before applications are deployed to production."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:3.7.4", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:3.7", "ref_id": "3.7.4", "description": "Web applications shall be protected against common vulnerabilities (OWASP Top 10)."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:3.7.5", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:3.7", "ref_id": "3.7.5", "description": "Application security testing shall be conducted regularly, including penetration testing."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:3.8", "assessable": false, "depth": 2, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:3", "ref_id": "3.8", "name": "Cryptography"},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:3.8.1", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:3.8", "ref_id": "3.8.1", "description": "A cryptographic policy shall be defined specifying approved algorithms and key lengths."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:3.8.2", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:3.8", "ref_id": "3.8.2", "description": "Sensitive data shall be encrypted in transit and at rest using approved cryptographic methods."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:3.8.3", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:3.8", "ref_id": "3.8.3", "description": "Cryptographic keys shall be managed throughout their lifecycle, including generation, storage, distribution, and destruction."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:3.8.4", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:3.8", "ref_id": "3.8.4", "description": "Digital certificates shall be managed appropriately, including timely renewal and revocation."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:3.9", "assessable": false, "depth": 2, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:3", "ref_id": "3.9", "name": "Data Protection"},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:3.9.1", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:3.9", "ref_id": "3.9.1", "description": "Data classification scheme shall be defined and implemented across the organization."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:3.9.2", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:3.9", "ref_id": "3.9.2", "description": "Data handling procedures shall be defined based on data classification."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:3.9.3", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:3.9", "ref_id": "3.9.3", "description": "Data loss prevention (DLP) controls shall be implemented to prevent unauthorized data exfiltration."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:3.9.4", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:3.9", "ref_id": "3.9.4", "description": "Data retention and disposal policies shall be defined and implemented."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:3.9.5", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:3.9", "ref_id": "3.9.5", "description": "Privacy requirements shall be addressed, including customer data protection."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:3.10", "assessable": false, "depth": 2, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:3", "ref_id": "3.10", "name": "Physical and Environmental Security"},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:3.10.1", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:3.10", "ref_id": "3.10.1", "description": "Physical security controls shall be implemented for facilities housing critical systems."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:3.10.2", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:3.10", "ref_id": "3.10.2", "description": "Access to secure areas shall be restricted and monitored."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:3.10.3", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:3.10", "ref_id": "3.10.3", "description": "Environmental controls shall be implemented to protect against natural and man-made disasters."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:3.10.4", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:3.10", "ref_id": "3.10.4", "description": "Equipment shall be protected against power failures and other utility disruptions."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:3.10.5", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:3.10", "ref_id": "3.10.5", "description": "Secure disposal procedures shall be implemented for equipment and storage media."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:3.11", "assessable": false, "depth": 2, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:3", "ref_id": "3.11", "name": "Security Monitoring"},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:3.11.1", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:3.11", "ref_id": "3.11.1", "description": "Security event logging shall be enabled on all critical systems and applications."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:3.11.2", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:3.11", "ref_id": "3.11.2", "description": "Security logs shall be centralized and protected against tampering."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:3.11.3", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:3.11", "ref_id": "3.11.3", "description": "Security logs shall be retained according to regulatory and organizational requirements."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:3.11.4", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:3.11", "ref_id": "3.11.4", "description": "A Security Operations Center (SOC) or equivalent function shall be established for continuous monitoring."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:3.11.5", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:3.11", "ref_id": "3.11.5", "description": "Security Information and Event Management (SIEM) solutions shall be deployed."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:3.12", "assessable": false, "depth": 2, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:3", "ref_id": "3.12", "name": "Vulnerability Management"},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:3.12.1", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:3.12", "ref_id": "3.12.1", "description": "A vulnerability management program shall be established covering all systems."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:3.12.2", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:3.12", "ref_id": "3.12.2", "description": "Vulnerability assessments shall be conducted at least quarterly for critical systems."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:3.12.3", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:3.12", "ref_id": "3.12.3", "description": "Penetration testing shall be conducted at least annually by qualified personnel."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:3.12.4", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:3.12", "ref_id": "3.12.4", "description": "Identified vulnerabilities shall be remediated based on their severity within defined timeframes."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:3.12.5", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:3.12", "ref_id": "3.12.5", "description": "Threat intelligence shall be used to prioritize vulnerability remediation."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:4", "assessable": false, "depth": 1, "ref_id": "4", "name": "Third Party Cyber Security"},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:4.1", "assessable": false, "depth": 2, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:4", "ref_id": "4.1", "name": "Third Party Risk Management"},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:4.1.1", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:4.1", "ref_id": "4.1.1", "description": "A third-party risk management framework shall be established covering the entire vendor lifecycle."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:4.1.2", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:4.1", "ref_id": "4.1.2", "description": "Due diligence assessments shall be conducted before engaging with third parties."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:4.1.3", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:4.1", "ref_id": "4.1.3", "description": "Third parties shall be classified based on the criticality of services provided and access to data."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:4.1.4", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:4.1", "ref_id": "4.1.4", "description": "Contracts with third parties shall include cyber security requirements and right to audit clauses."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:4.1.5", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:4.1", "ref_id": "4.1.5", "description": "Third-party performance and compliance shall be monitored throughout the relationship."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:4.1.6", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:4.1", "ref_id": "4.1.6", "description": "Exit strategies shall be defined for critical third-party relationships."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:4.2", "assessable": false, "depth": 2, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:4", "ref_id": "4.2", "name": "Outsourcing Security"},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:4.2.1", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:4.2", "ref_id": "4.2.1", "description": "Outsourcing arrangements shall be governed by formal agreements including security requirements."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:4.2.2", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:4.2", "ref_id": "4.2.2", "description": "Service level agreements (SLAs) shall include security metrics and reporting requirements."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:4.2.3", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:4.2", "ref_id": "4.2.3", "description": "Access by outsourced service providers shall be monitored and controlled."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:4.3", "assessable": false, "depth": 2, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:4", "ref_id": "4.3", "name": "Cloud Security"},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:4.3.1", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:4.3", "ref_id": "4.3.1", "description": "Cloud service usage shall be governed by a formal policy addressing security requirements."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:4.3.2", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:4.3", "ref_id": "4.3.2", "description": "Cloud service providers shall be assessed for security capabilities before engagement."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:4.3.3", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:4.3", "ref_id": "4.3.3", "description": "Data residency and sovereignty requirements shall be considered when using cloud services."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:4.3.4", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:4.3", "ref_id": "4.3.4", "description": "Shared responsibility models shall be understood and security controls implemented accordingly."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:5", "assessable": false, "depth": 1, "ref_id": "5", "name": "Cyber Security Incident Management"},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:5.1", "assessable": false, "depth": 2, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:5", "ref_id": "5.1", "name": "Incident Response"},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:5.1.1", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:5.1", "ref_id": "5.1.1", "description": "An incident response plan shall be developed and maintained covering all types of cyber security incidents."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:5.1.2", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:5.1", "ref_id": "5.1.2", "description": "An incident response team shall be established with defined roles and responsibilities."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:5.1.3", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:5.1", "ref_id": "5.1.3", "description": "Incident classification and prioritization procedures shall be defined."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:5.1.4", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:5.1", "ref_id": "5.1.4", "description": "Communication procedures shall be defined for internal and external stakeholders during incidents."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:5.1.5", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:5.1", "ref_id": "5.1.5", "description": "SAMA shall be notified of significant cyber security incidents within the required timeframe."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:5.1.6", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:5.1", "ref_id": "5.1.6", "description": "Post-incident reviews shall be conducted and lessons learned documented."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:5.1.7", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:5.1", "ref_id": "5.1.7", "description": "Incident response capabilities shall be tested at least annually through exercises."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:5.2", "assessable": false, "depth": 2, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:5", "ref_id": "5.2", "name": "Digital Forensics"},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:5.2.1", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:5.2", "ref_id": "5.2.1", "description": "Digital forensics capabilities shall be established either internally or through third parties."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:5.2.2", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:5.2", "ref_id": "5.2.2", "description": "Evidence handling procedures shall be defined to maintain chain of custody."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:5.2.3", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:5.2", "ref_id": "5.2.3", "description": "Forensic investigation results shall be documented and preserved for potential legal proceedings."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:6", "assessable": false, "depth": 1, "ref_id": "6", "name": "Cyber Security Business Continuity"},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:6.1", "assessable": false, "depth": 2, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:6", "ref_id": "6.1", "name": "Business Continuity Planning"},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:6.1.1", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:6.1", "ref_id": "6.1.1", "description": "Business Impact Analysis (BIA) shall be conducted to identify critical business functions and dependencies."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:6.1.2", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:6.1", "ref_id": "6.1.2", "description": "Business continuity plans shall be developed addressing cyber security incident scenarios."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:6.1.3", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:6.1", "ref_id": "6.1.3", "description": "Recovery Time Objectives (RTO) and Recovery Point Objectives (RPO) shall be defined for critical systems."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:6.1.4", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:6.1", "ref_id": "6.1.4", "description": "Business continuity plans shall be tested at least annually."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:6.2", "assessable": false, "depth": 2, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:6", "ref_id": "6.2", "name": "Disaster Recovery"},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:6.2.1", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:6.2", "ref_id": "6.2.1", "description": "Disaster recovery plans shall be developed for critical systems and data."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:6.2.2", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:6.2", "ref_id": "6.2.2", "description": "Backup and recovery procedures shall be implemented for critical systems and data."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:6.2.3", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:6.2", "ref_id": "6.2.3", "description": "Backup data shall be stored securely at offsite locations."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:6.2.4", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:6.2", "ref_id": "6.2.4", "description": "Disaster recovery capabilities shall be tested at least annually."},
        {"urn": "urn:intuitem:risk:req_node:sama-csf:6.2.5", "assessable": true, "depth": 3, "parent_urn": "urn:intuitem:risk:req_node:sama-csf:6.2", "ref_id": "6.2.5", "description": "Alternate processing sites shall be available for critical systems if required."}
      ]
    }
  }
}
